# Copy to .env and fill in. Never commit .env. Keys are read only by the API process and are
# never sent to the browser. With no key configured, the agent uses the deterministic planner
# and every trace says so.

# ---- Model providers (Responses API) ----
# Default provider for agent runs: meta | fireworks
FORESIGHT_LLM_PROVIDER=meta

# Meta Model API (Muse Spark 1.3)
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
FORESIGHT_REASONING_MODEL=muse-spark-1.3

# Fireworks AI (Muse Spark Open, open weights)
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/muse-spark-open

# meta: minimal|low|medium|high|xhigh · fireworks: low|medium|high|xhigh
FORESIGHT_REASONING_EFFORT=medium
FORESIGHT_LLM_TIMEOUT_S=90
FORESIGHT_LLM_MAX_RETRIES=3

# ---- Agent bounds ----
FORESIGHT_AGENT_MAX_TOOL_CALLS=12
FORESIGHT_AGENT_MAX_REVISIONS=2
FORESIGHT_AGENT_TIMEOUT_S=300

# ---- API ----
FORESIGHT_CORS_ORIGINS=http://localhost:3000
FORESIGHT_SIM_SPEED=60

# ---- Cost accounting (USD per 1M tokens; list prices, used only for trace estimates) ----
FORESIGHT_PRICE_INPUT_PER_M=1.25
FORESIGHT_PRICE_OUTPUT_PER_M=4.25
FIREWORKS_PRICE_INPUT_PER_M=1.25
FIREWORKS_PRICE_CACHED_INPUT_PER_M=0.15
FIREWORKS_PRICE_OUTPUT_PER_M=4.25
